{
  "name": "eslint-config-jeremy",
  "version": "1.0.1",
  "description": "Shareable ESLint 9+/10 flat config with interactive CLI setup",
  "author": "Jeremy Chung-Ying Ho",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "vue",
    "astro",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "eslint-config-jeremy": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "node dist/scripts/postinstall.js",
    "prepublishOnly": "npm run build && npm run test:run"
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0 || ^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-import-x": "^4.6.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-import-x": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChungYingHo/eslint-config-jeremy"
  },
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^1.1.0",
    "@types/node": "^25.5.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
